# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Graph API (OAuth de social_accounts / sync de insights)
NEXT_PUBLIC_META_APP_ID=
META_APP_ID=
META_APP_SECRET=
# URL de callback cadastrada no Meta App Dashboard (Facebook Login), ex:
# https://app.exemplo.com/api/auth/instagram/callback
META_REDIRECT_URI=

# Resend (notifications)
RESEND_API_KEY=

# Gemini (lib/llm/index.ts) -- usada pelo agent-worker (Fase 5) para gerar
# sugestao de legenda (agent_tasks.type = 'sugerir_legenda'). Sem essa variavel,
# suggestCaption() lanca LlmCredentialsError e a rota responde 501.
# GEMINI_API_KEY=

# Job de publicação automática (app/api/publish/route.ts) — header
# x-cron-secret esperado nas chamadas do agendador (Vercel Cron / Supabase
# Edge Function). Sem essa variável configurada, a rota recusa toda chamada.
CRON_SECRET=

# Deploy (usados pelo GitHub Actions, não pelo app em runtime)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
